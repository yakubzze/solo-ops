{
  "name": "solo-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first issue tracker for one person running many fronts",
  "license": "MIT",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "serve": "npm run build && node server/index.mjs",
    "typecheck": "tsc -b",
    "integrity": "node scripts/integrity.test.mjs",
    "undo": "node scripts/undo.test.mjs",
    "smoke": "esbuild scripts/smoke.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.mjs --external:react --external:react-dom --log-level=error && node node_modules/.cache/smoke.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
